{
  "name": "@nurul-huda/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint src tests drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "db:verify": "tsx --env-file-if-exists=.env src/scripts/verify-database.ts",
    "db:diagram": "tsx src/scripts/print-dbml.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^5.0.1"
  }
}

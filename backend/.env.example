NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Docker uses this password and builds its own DATABASE_URL automatically.
POSTGRES_PASSWORD=change-me
# Used only when running the backend outside Docker with a separate local database.
DATABASE_URL=postgres://nurul_huda:change-me@127.0.0.1:5432/nurul_huda
FRONTEND_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=nh_admin_session
SESSION_TTL_HOURS=12
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
TRUST_PROXY=false
